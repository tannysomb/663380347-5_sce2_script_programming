# =====================================================================
# agentic-communication-automator — Configuration Template
# =====================================================================
# วิธีใช้:
# 1. คัดลอกไฟล์นี้แล้วเปลี่ยนชื่อเป็น .env
#       copy .env.example .env        (Windows)
#       cp .env.example .env          (macOS / Linux)
# 2. แทนที่ค่าตัวอย่างด้านล่างด้วยค่าจริงของคุณ
# 3. คำเตือน: ห้าม commit ไฟล์ .env ตัวจริงขึ้น GitHub เด็ดขาด
#    (.gitignore กันไว้ให้แล้ว)
# =====================================================================

# ---------------------------------------------------------------------
# บัญชีอีเมลผู้ส่ง (แนะนำ Gmail)
# ---------------------------------------------------------------------
SENDER_EMAIL=your_email@gmail.com

# App Password 16 ตัวอักษรจาก Google Account — ไม่ใช่รหัสผ่านที่ใช้ล็อกอินปกติ
# วิธีสร้าง:
#   1. ไปที่ https://myaccount.google.com/
#   2. เลือกเมนู "Security" (ความปลอดภัย)
#   3. เปิด "2-Step Verification" (ยืนยันตัวตน 2 ขั้นตอน) ให้เรียบร้อยก่อน
#   4. ค้นหาหรือเลือก "App passwords"
#   5. สร้างรหัสใหม่ ตั้งชื่อเช่น "Python Automator"
#   6. คัดลอกรหัส 16 ตัวมาวางด้านล่าง (ไม่ต้องเว้นวรรค)
SENDER_APP_PASSWORD=your_16_digit_app_password

# ---------------------------------------------------------------------
# การตั้งค่าเซิร์ฟเวอร์เมล
# ---------------------------------------------------------------------
# เซิร์ฟเวอร์สำหรับ "ส่ง" อีเมล (Gmail: smtp.gmail.com, Outlook: smtp.office365.com)
SMTP_SERVER=smtp.gmail.com

# พอร์ต SMTP (587 สำหรับ STARTTLS)
SMTP_PORT=587

# เซิร์ฟเวอร์สำหรับ "รับ" อีเมล (Gmail: imap.gmail.com, Outlook: outlook.office365.com)
IMAP_SERVER=imap.gmail.com
